<%# The tick glyph this replaced rendered as nothing on the account page, so a
    screen whose whole job is to say which capabilities a tenant has said it in a
    12px icon nobody could see. A word is legible and needs no sprite. %>
<span class="<%= enabled ? 'bg-green-100 text-green-800' : 'bg-slate-100 text-slate-600' %> rounded-full px-2 py-0.5 text-xs font-medium whitespace-nowrap">
  <%= enabled ? 'Bật' : 'Tắt' %>
</span>
