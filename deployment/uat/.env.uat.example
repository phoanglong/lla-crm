# LLA CRM UAT — template. Copy to deployment/uat/.env.uat and fill in.
#
# `.env.*` is git-ignored: the real file must never be committed, and every value
# in it must be synthetic. If a value here would also unlock something in
# production, it does not belong in a UAT stack.
#
# Generate the two secrets with, for example:
#   openssl rand -hex 64      # SECRET_KEY_BASE
#   openssl rand -hex 32      # POSTGRES_PASSWORD / REDIS_PASSWORD

# The exact image under test, pinned by digest. A tag is not acceptable: it can be
# repointed between a test run and the evidence that describes it.
LLA_IMAGE=lla-crm@sha256:REPLACE_WITH_DIGEST
LLA_UAT_PORT=4185

SECRET_KEY_BASE=REPLACE
POSTGRES_PASSWORD=REPLACE
REDIS_PASSWORD=REPLACE

# UAT is reached over loopback. Nothing here may be a production hostname.
FRONTEND_URL=http://127.0.0.1:4185
HELPCENTER_URL=http://127.0.0.1:4185

# Mail goes nowhere. A UAT run must not be able to email a real person.
MAILER_SENDER_EMAIL="LLA CRM UAT <uat@lla.invalid>"
SMTP_ADDRESS=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# Storage stays on the local volume; no bucket, no cloud credential.
ACTIVE_STORAGE_SERVICE=local

# Provider capabilities. Every one OFF, and each needs its own owner decision plus a
# provider sandbox before it can be turned on even here.
#
# These are the exact names the code reads — `Lla::Knowledge::ProviderPolicy`
# CAPABILITY_FLAGS and GLOBAL_EGRESS_FLAG, and `Lla::WidgetsController`. A name that
# nothing reads is worse than an absent one: it reads as a switch that has been
# thrown. `spec/lla/config/uat_capability_flags_spec.rb` fails if this list and the
# code drift apart.
DISABLE_ENTERPRISE=true
LLA_KNOWLEDGE_EXTERNAL_EGRESS_ENABLED=false
LLA_ONBOARDING_WORKSPACE_ENABLED=false
LLA_KNOWLEDGE_WEBSITE_ANALYSIS_ENABLED=false
LLA_KNOWLEDGE_WIDGET_TAGLINE_ENABLED=false
LLA_KNOWLEDGE_EXTERNAL_CRAWL_ENABLED=false
LLA_KNOWLEDGE_ARTICLE_GENERATION_ENABLED=false
LLA_KNOWLEDGE_ARTICLE_TRANSLATION_ENABLED=false
LLA_KNOWLEDGE_EMBEDDING_SEARCH_ENABLED=false
LLA_KNOWLEDGE_WEBSITE_ENRICHMENT_ENABLED=false
LLA_CUSTOM_DOMAINS_ENABLED=false
LLA_WIDGET_GEOIP_ENABLED=false
LLA_CLOUDFLARE_API_TOKEN_REF=
LLA_CLOUDFLARE_ZONE_ID_REF=
LLA_CONTEXT_DEV_API_KEY_REF=

# Observability off by default; a UAT run should not ship telemetry anywhere real.
ENABLE_ACCOUNT_SIGNUP=false
LOG_LEVEL=info
