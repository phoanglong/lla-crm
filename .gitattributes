# Every text file is LF in every working tree, on every platform.
#
# Without this, a Windows checkout (git's `core.autocrlf=true` default) rewrites
# every uncovered file to CRLF. Two things then break: `#!/bin/sh` becomes
# `#!/bin/sh\r` and the container dies with "no such file or directory", and the
# asset pipeline hashes different bytes, so an image built from one commit is not
# the image built from that same commit elsewhere. `text=auto` still detects
# binaries by content, so fonts, images and archives are left alone.
* text=auto eol=lf

# Windows-only scripts are the exception: they are read by cmd.exe, not by sh.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Explicit, because these are the ones whose CRLF failure mode is fatal at runtime
# rather than cosmetic.
*.sh text eol=lf
*.py text eol=lf
.husky/* text eol=lf
bin/* text eol=lf
docker/entrypoints/* text eol=lf
/.gitattributes text eol=lf

*.rb text eol=lf
*.rake text eol=lf
*.jbuilder text eol=lf
*.erb text eol=lf
*.liquid text eol=lf
*.js text eol=lf
*.json text eol=lf
*.vue text eol=lf
*.yml text eol=lf
Gemfile text eol=lf
Gemfile.lock text eol=lf
